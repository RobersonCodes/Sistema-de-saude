############################################
# Variáveis de ambiente — Sistema de Saúde Municipal
#
# Copie este arquivo para ".env" (ou configure estas mesmas chaves no
# secrets manager da sua plataforma de deploy) e preencha com valores reais.
# NUNCA commite o ".env" com valores reais — ele já está no .gitignore.
############################################

# Chave de assinatura do JWT. OBRIGATÓRIA em produção.
# Gere uma nova com: openssl rand -base64 64
JWT_SECRET=

# Validade do token em milissegundos (opcional; default 86400000 = 24h)
JWT_EXPIRATION=86400000

# Conexão com o MySQL. OBRIGATÓRIAS em produção.
DB_URL=jdbc:mysql://HOST:3306/saude_municipal_sl
DB_USERNAME=
DB_PASSWORD=

# Chave da API da OpenAI. Sem ela, os endpoints de IA/chat respondem com
# mensagem de indisponibilidade em vez de derrubar a aplicação.
OPENAI_API_KEY=

# Modelo da OpenAI usado na interpretação de linguagem natural (opcional;
# default gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
